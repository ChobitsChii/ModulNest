RewriteEngine On

# Upload-Limits für Medien/Avatare
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>

# Falls eine echte Datei oder ein echtes Verzeichnis angefragt wird: direkt ausliefern.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alles andere an den Front Controller delegieren.
RewriteRule ^ index.php [QSA,L]
