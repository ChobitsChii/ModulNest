{
  "name": "modulon/modulon",
  "description": "Grundsystem fuer das Modulon-Projekt.",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-iconv": "*",
    "robthree/twofactorauth": "^3.0",
    "lbuchs/webauthn": "^2.2",
    "chillerlan/php-qrcode": "^6.0",
    "webklex/php-imap": "^6.2",
    "symfony/mailer": "^8.0",
    "symfony/mime": "^8.0",
    "league/commonmark": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "Modulon\\": "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@composer dump-autoload"
    ],
    "post-update-cmd": [
      "@composer dump-autoload"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
